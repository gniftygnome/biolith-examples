      "material_rules": [
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:biome",
            "biome_is": [
              "minecraft:birch_forest"
            ]
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": "minecraft:calcite"
          }
        }
      ]
    },
    {
